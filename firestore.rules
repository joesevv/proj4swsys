rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validNewTask() {
      return request.resource.data.keys().hasOnly(['title', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['title', 'status', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.status == 'todo'
        && request.resource.data.createdAt == request.time;
    }
    match /boards/{boardId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow write: if false;
      match /tasks/{taskId} {
        allow read: if boardId == 'shared' && request.auth != null;
        allow create: if boardId == 'shared'
          && request.auth != null
          && validNewTask();
        allow update, delete: if false;
      }
    }
  }
}